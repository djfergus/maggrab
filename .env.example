# MyJDownloader credentials
MYJD_EMAIL=your_email@example.com
MYJD_PASSWORD=your_password
# JDownloader device name to send links to (recommended if your account has more than one)
MYJD_DEVICE=
# Send downup links first via the downup-resolver service (leave empty for novafile only)
DOWNUP_RESOLVER_URL=
# Minutes to wait for downup (cooldown/errors) before falling back to novafile
DOWNUP_MAX_DEFER_MINUTES=180
# Minutes a resolved downup link is reused if sending it to JDownloader fails
DOWNUP_LINK_TTL_MINUTES=60
